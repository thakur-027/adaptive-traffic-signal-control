# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual envs
.venv/
venv/
env/

# OS / IDE
.DS_Store
.vscode/
.idea/

# Secrets. The project needs none - it has no API keys, no database and makes no
# outbound calls - so anything matching these is a local experiment that must not be
# published. Configure hosting-platform values as environment variables in the
# platform's own dashboard, never in a committed file.
.env
.env.*
!.env.example
*.pem
*.key
!models/**/*.key
secrets.*
credentials.json
*_token.txt
.netrc

# Generated SUMO networks and logs (rebuilt on demand)
scenarios/generated/
*.log

# outputs/ IS tracked on purpose: README.md and REPORT.md quote
# these exact CSVs/plots, so the published repo has to carry its own evidence.
# That includes outputs/sumo/ (the same benchmark on SUMO) and outputs/study/ (model
# selection, training-to-training variation, ablation).
# Only throwaway artefacts are ignored: the --quick training log and curve, a benchmark on
# whichever backend "auto" picks, and browser-check screenshots.
outputs/logs/train_quick.csv
outputs/training_curve_quick.png
outputs/auto/
outputs/e2e/

# Personal study notes for the project defence: kept on the author's machine, not published
CHEATSHEET.md
docs/VIVA_MASTER.md

# Local-only artefacts: zips (share one through a GitHub Release instead) and the slide
# deck (a submission artefact, handed in separately)
*.zip
*.pptx

# Keep the shipped pre-trained model, but ignore ad-hoc checkpoints
models/checkpoints/
models/**/*.tmp

# TensorBoard
runs/

# Do NOT ignore the shipped pretrained model, nor the models of the model study
# (models/seeds/: the five training seeds; models/ablation/: one ingredient removed each):
!models/pretrained/
!models/pretrained/**
# ...except the few-minute models `run.py train --quick` writes next to it
models/pretrained/*_quick.pt
models/pretrained/*_quick_final.pt
